<!-- -V10 NOVI FAJL — forma za registraciju                   -->
<!-- ======================================================== -->
<!DOCTYPE html>
<html lang="bs">
  <head>
    <meta charset="UTF-8" />
    <title>Registracija</title>
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        margin: 0; padding: 30px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff; min-height: 100vh;
      }
      .container { max-width: 450px; margin: 40px auto; }
      h1 { margin-top: 0; text-align: center; }
      form {
        background: rgba(255,255,255,0.1);
        padding: 24px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.2);
      }
      label { display: block; margin-top: 14px; margin-bottom: 6px; font-weight: 600; }
      input {
        width: 100%; padding: 10px;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.15);
        color: #fff; font-size: 1em;
      }
      button {
        width: 100%; padding: 12px;
        margin-top: 20px;
        border-radius: 8px;
        border: 1px solid rgba(80,200,120,0.6);
        background: rgba(80, 200, 120, 0.4);
        color: #fff; font-size: 1em;
        cursor: pointer;
      }
      button:hover { background: rgba(80, 200, 120, 0.6); }
      .greska {
        background: rgba(255, 80, 80, 0.3);
        border: 1px solid rgba(255,120,120,0.5);
        padding: 10px 14px;
        border-radius: 8px;
        margin-bottom: 16px;
      }
      .link { text-align: center; margin-top: 16px; }
      .link a { color: #fff; }
      small { opacity: 0.7; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>📝 Registracija</h1>

      <form method="POST" action="/registracija">
        <% if (greska) { %>
          <div class="greska">⚠️ <%= greska %></div>
        <% } %>

        <label for="korisnicko_ime">Korisnicko ime *</label>
        <input id="korisnicko_ime" name="korisnicko_ime" type="text" required
               value="<%= vrijednosti.korisnicko_ime || '' %>" />

        <label for="email">Email *</label>
        <input id="email" name="email" type="email" required
               value="<%= vrijednosti.email || '' %>" />

        <label for="lozinka">Lozinka * <small>(min. 6 karaktera)</small></label>
        <input id="lozinka" name="lozinka" type="password" minlength="6" required />

        <label for="lozinka2">Ponovi lozinku *</label>
        <input id="lozinka2" name="lozinka2" type="password" minlength="6" required />

        <button type="submit">Registruj se</button>
      </form>

      <div class="link">
        Vec imas nalog? <a href="/login">Prijavi se</a>
      </div>
    </div>
  </body>
</html>
