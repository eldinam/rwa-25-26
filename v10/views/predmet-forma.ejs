<!-- ======================================================== -->
<!-- -V9  Forma za unos / izmjenu predmeta                    -->
<!-- ======================================================== -->
<!DOCTYPE html>
<html lang="bs">
  <head>
    <meta charset="UTF-8" />
    <title><%= predmet ? "Uredi predmet" : "Novi predmet" %></title>
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        margin: 0; padding: 30px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff; min-height: 100vh;
      }
      .container { max-width: 500px; margin: 0 auto; }
      h1 { margin-top: 0; }
      form {
        background: rgba(255,255,255,0.1);
        padding: 24px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.2);
      }
      label { display: block; margin-top: 14px; margin-bottom: 6px; font-weight: 600; }
      input {
        width: 100%; padding: 10px;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.15);
        color: #fff; font-size: 1em;
      }
      .row { display: flex; gap: 12px; margin-top: 20px; }
      button, a.btn {
        flex: 1; padding: 11px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.2);
        color: #fff; font-size: 1em;
        cursor: pointer; text-align: center;
        text-decoration: none;
      }
      .primary { background: rgba(80, 200, 120, 0.4); border-color: rgba(80,200,120,0.6); }
      .greska {
        background: rgba(255, 80, 80, 0.3);
        border: 1px solid rgba(255,120,120,0.5);
        padding: 10px 14px;
        border-radius: 8px;
        margin-bottom: 16px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>
        <% if (predmet && predmet.id) { %>✏️ Uredi predmet<% } else { %>➕ Novi predmet<% } %>
      </h1>

      <% if (greska) { %>
        <div class="greska">⚠️ <%= greska %></div>
      <% } %>

      <form method="POST"
            action="<%= predmet && predmet.id ? '/predmeti/' + predmet.id + '/uredi' : '/predmeti' %>">
        <label for="naziv">Naziv *</label>
        <input id="naziv" name="naziv" type="text" required
               value="<%= predmet ? predmet.naziv : '' %>"
               placeholder="npr. Razvoj web aplikacija" />

        <label for="ects">ECTS *</label>
        <input id="ects" name="ects" type="number" min="1" max="30" required
               value="<%= predmet ? predmet.ects : '' %>" />

        <div class="row">
          <a class="btn" href="/predmeti">Odustani</a>
          <button class="primary" type="submit">Sacuvaj</button>
        </div>
      </form>
    </div>
  </body>
</html>
